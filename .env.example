# ═══════════════════════════════════════════════════════════════════
#  Robinhood LP Bot v2 — .env
#
#  1. Rename file ini jadi  .env   (buang ".example")
#  2. Isi baris di bawah
#  3. JANGAN pernah share / commit / screenshot file ini.
#     Private key = duit lu. Bocor = habis.
# ═══════════════════════════════════════════════════════════════════

# ── 1) RPC utama — buat mint, close, baca posisi ───────────────────
#  Bikin app gratis di https://alchemy.com → pilih chain "Robinhood"
#  Copy HTTPS URL-nya ke sini.
RH_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/GANTI_API_KEY_LU

# ── 2) Private key wallet EVM (0x… 64 hex) ─────────────────────────
#  PAKAI WALLET BARU / BURNER. Jangan wallet utama.
#  Isi ETH di Robinhood Chain buat modal LP + gas.
#  Bikin wallet baru cepat:  node -e "console.log(require('ethers').Wallet.createRandom().privateKey)"
RH_WALLET_KEY=0xGANTI_PRIVATE_KEY_LU

# ── 3) Token bot Telegram ──────────────────────────────────────────
#  Chat @BotFather di Telegram → /newbot → copy token-nya ke sini.
RH_TG_TOKEN=GANTI_TOKEN_BOTFATHER

# ── 4) OWNER chat id — GERBANG KEAMANAN. ISI INI. ──────────────────
#  Cuma chat ini yang boleh nyuruh bot (mint/close/sell). Tanpa ini,
#  siapa pun yang nemu bot lu bisa nguras wallet.
#  Kalau dikosongin: bot ngunci ke chat PERTAMA yang kirim /start, lalu
#  nolak yang lain — tapi lebih aman diisi eksplisit.
#  Cara dapet id: chat @userinfobot di Telegram, dia kasih angka id lu.
RH_TG_CHAT=

# ── 5) RPC khusus scan volume (OPSIONAL tapi disaranin) ────────────
#  Bikin app Alchemy KEDUA, pakai key beda.
#  Kenapa dipisah: scanner nembak RPC tiap 2 menit. Kalau numpang RPC
#  utama, kuota bisa jebol pas lu lagi close posisi → tx nyangkut.
#  Kosongin kalau nggak mau — otomatis numpang RPC utama.
RH_WATCH_RPC_URL=

# ── 6) Sequencer feed monitor (OPSIONAL) ──────────────────────────
#  Aktifin real-time deteksi token baru + posisi out-of-range dari feed
#  Nitro. Nyalain lewat Telegram: /feed on   (atau feed.enabled di config)
#
#  RH_FEED_IP: WAJIB kalau jalan di jaringan yang hijack DNS domain feed
#  (mis. Telkomsel "Internet Baik"). Pin ke IP Cloudflare asli biar tembus.
#  Di VPS US kosongin aja.
#  IP asli: 172.66.147.70  atau  104.20.46.209
RH_FEED_IP=
#  (opsional) override URL feed kalau perlu:
# RH_FEED_URL=wss://feed.mainnet.chain.robinhood.com/feed

# ── 7) Fast-submit ke sequencer (OPSIONAL) ────────────────────────
#  Broadcast tx langsung ke sequencer (AWS Ohio) — skip hop relay Alchemy.
#  Baca tetep via Alchemy; cuma eth_sendRawTransaction yang dialihin.
#  Paling ngefek kalau bot jalan di VPS US. Nyalain: set ke 1.
RH_FAST_SUBMIT=
#  (opsional) override URL/IP sequencer. IP-pin kalau DNS di-hijack (lokal).
# RH_SEQUENCER_URL=https://sequencer.mainnet.chain.robinhood.com/
# RH_SEQUENCER_IP=3.136.74.196

# ── 8) Radar LLM (OpenRouter) — OPSIONAL ───────────────────────────
#  Skoring/konfirmasi kandidat token pakai LLM (pola meridian).
#  Bikin key di https://openrouter.ai/keys. Nyalain: /set radar 1
RH_OPENROUTER_KEY=
#  Model (default gratis). Contoh lain: anthropic/claude-3.5-haiku, x-ai/grok-2
# RH_OPENROUTER_MODEL=openai/gpt-oss-20b:free

# ── 9) GMGN enrichment — OPSIONAL ──────────────────────────────────
#  Enrich kandidat pakai data GMGN (smart money, holders, security) via gmgn-cli.
#  Setup di mesin yang JALANIN bot (key ke-bind ke keypair lokal):
#    npm install -g gmgn-cli
#    gmgn-cli config              # generate keypair + kasih URL
#    # buka URL, bikin API key buat public key yang ditampilin, lalu:
#    gmgn-cli config --apply <API_KEY>
#  Bot manggil gmgn-cli otomatis; nggak perlu env di sini.

# ── (opsional) logging ─────────────────────────────────────────────
#  LOG_LEVEL: debug | info | warn | error   (default info)
#  LOG_FILE : path file buat nyimpen log (default: cuma stdout)
# LOG_LEVEL=info
# LOG_FILE=bot.log
